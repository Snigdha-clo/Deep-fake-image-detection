# %% ------------------------- 4. BASELINE: frozen ViT features + LogReg
if RUN_BASELINE:
    import time
    import json
    import joblib
    from pathlib import Path
    from sklearn.linear_model import LogisticRegression
    from sklearn.metrics import (accuracy_score, precision_score, recall_score,
                                 f1_score, roc_auc_score, classification_report,
                                 confusion_matrix)

    # --- feature extractor: ViT backbone without the classification head ----
    # NOTE: this cell was missing from the latest notebook export (it exists in
    # the earlier PROJECT.ipynb); it is required by the baseline.
    feature_model = models_vit.VisionTransformer(
        num_classes=0,                    # no classification head
        patches=cfg.patches,
        transformer=cfg.transformer,
        hidden_size=cfg.hidden_size,
        classifier=cfg.classifier,
        representation_size=None,
    )
    feature_variables = {"params": {k: v for k, v in variables["params"].items()
                                    if k != "head"}}

    @jax.jit
    def extract_features(images):
        return feature_model.apply(feature_variables, images, train=False)

    def extract_split_features(ds, split_name):
        feats, labs = [], []
        t0 = time.time()
        for start in range(0, len(ds), FEATURE_BATCH_SIZE):
            end = min(start + FEATURE_BATCH_SIZE, len(ds))
            samples = [ds[i] for i in range(start, end)]
            batch = np.stack([preprocess_image(s["image"]) for s in samples])
            feats.append(np.asarray(extract_features(jnp.asarray(batch))))
            labs.extend(s["label"] for s in samples)
            if (start // FEATURE_BATCH_SIZE) % 100 == 0:
                print(f"{split_name}: {end}/{len(ds)} images processed")
        X = np.concatenate(feats).astype(np.float32)
        y = np.asarray(labs, dtype=np.int32)
        np.savez_compressed(f"{RESULTS_DIR}/{split_name}_features.npz",
                            features=X, labels=y)
        print(f"{split_name} done: {X.shape}, {(time.time() - t0) / 60:.2f} min")
        return X, y

    X_train, y_train = extract_split_features(train_ds, "train")
    X_val, y_val = extract_split_features(val_ds, "validation")
    X_test, y_test = extract_split_features(test_ds, "test")

    # --- choose C on validation ROC-AUC only --------------------------------
    best_C, best_val_auc = None, -1.0
    for C in [0.01, 0.1, 1.0, 10.0]:
        clf = LogisticRegression(C=C, max_iter=1000, class_weight="balanced",
                                 random_state=SEED).fit(X_train, y_train)
        auc_val = roc_auc_score(y_val, clf.predict_proba(X_val)[:, 1])
        print(f"C={C}: validation ROC-AUC={auc_val:.4f}")
        if auc_val > best_val_auc:
            best_C, best_val_auc = C, auc_val
    print("Selected C:", best_C, "| best validation ROC-AUC:", round(best_val_auc, 4))

    # --- final baseline: refit on train + validation, evaluate on test ------
    final_classifier = LogisticRegression(
        C=best_C, max_iter=1000, class_weight="balanced", random_state=SEED
    ).fit(np.concatenate([X_train, X_val]), np.concatenate([y_train, y_val]))

    test_probs = final_classifier.predict_proba(X_test)[:, 1]
    test_preds = final_classifier.predict(X_test)
    print("Test accuracy :", round(accuracy_score(y_test, test_preds), 4))
    print("Test precision:", round(precision_score(y_test, test_preds), 4))
    print("Test recall   :", round(recall_score(y_test, test_preds), 4))
    print("Test F1       :", round(f1_score(y_test, test_preds), 4))
    print("Test ROC-AUC  :", round(roc_auc_score(y_test, test_probs), 4))
    print(classification_report(y_test, test_preds, labels=[0, 1],
                                target_names=["Fake", "Real"], zero_division=0))
    print("Confusion matrix:\n", confusion_matrix(y_test, test_preds))

    # --- optional: decision threshold tuned on validation (train-only fit) --
    threshold_model = LogisticRegression(
        C=best_C, max_iter=1000, class_weight="balanced", random_state=SEED
    ).fit(X_train, y_train)
    val_probs = threshold_model.predict_proba(X_val)[:, 1]
    best_threshold, best_macro_f1 = 0.5, -1.0
    for thr in np.arange(0.20, 0.81, 0.02):
        score = f1_score(y_val, (val_probs >= thr).astype(int), average="macro")
        if score > best_macro_f1:
            best_threshold, best_macro_f1 = thr, score
    print("Selected threshold:", round(best_threshold, 2),
          "| validation macro-F1:", round(best_macro_f1, 4))
    tp = threshold_model.predict_proba(X_test)[:, 1]
    tpred = (tp >= best_threshold).astype(int)
    print("Tuned-threshold test accuracy:", round(accuracy_score(y_test, tpred), 4),
          "| ROC-AUC:", round(roc_auc_score(y_test, tp), 4))
    print("Confusion matrix:\n", confusion_matrix(y_test, tpred))

    # --- save baseline artifacts -------------------------------------------
    joblib.dump(final_classifier, f"{RESULTS_DIR}/vit_frozen_logistic_baseline.joblib")
    baseline_metrics = {
        "model": "Google Research ViT-B/16 frozen features + Logistic Regression",
        "dataset": "OpenDeepfake-Preview",
        "training_images": len(train_ds),
        "validation_images": len(val_ds),
        "test_images": len(test_ds),
        "best_C": float(best_C),
        "accuracy": float(accuracy_score(y_test, test_preds)),
        "precision_macro": float(precision_score(y_test, test_preds, average="macro")),
        "recall_macro": float(recall_score(y_test, test_preds, average="macro")),
        "f1_macro": float(f1_score(y_test, test_preds, average="macro")),
        "roc_auc": float(roc_auc_score(y_test, test_probs)),
    }
    with open(f"{RESULTS_DIR}/baseline_metrics.json", "w") as f:
        json.dump(baseline_metrics, f, indent=4)
    print(json.dumps(baseline_metrics, indent=4))


# %% --------------------------------- 5. FINE-TUNING (all parameters)
import time
import json
from flax import serialization
from sklearn.metrics import (accuracy_score, precision_score, recall_score,
                             f1_score, roc_auc_score, confusion_matrix,
                             classification_report)

np.random.seed(SEED)

optimizer = optax.adamw(learning_rate=LEARNING_RATE, weight_decay=WEIGHT_DECAY)


@jax.jit
def train_step(params, opt_state, images, labels):
    def loss_fn(current_params):
        logits = model.apply({"params": current_params}, images, train=True)
        loss = optax.softmax_cross_entropy_with_integer_labels(logits, labels).mean()
        accuracy = jnp.mean(jnp.argmax(logits, axis=-1) == labels)
        return loss, accuracy

    (loss, accuracy), grads = jax.value_and_grad(loss_fn, has_aux=True)(params)
    updates, new_opt_state = optimizer.update(grads, opt_state, params)
    return optax.apply_updates(params, updates), new_opt_state, loss, accuracy


@jax.jit
def eval_step(params, images, labels):
    logits = model.apply({"params": params}, images, train=False)
    loss_sum = optax.softmax_cross_entropy_with_integer_labels(logits, labels).sum()
    return loss_sum, jnp.sum(jnp.argmax(logits, axis=-1) == labels)


def evaluate_model(params, ds, batch_size=EVAL_BATCH_SIZE):
    """Return (mean loss, accuracy) of `params` on `ds`."""
    total_loss, total_correct, total = 0.0, 0, 0
    for images, labels in create_batches(ds, batch_size=batch_size):
        loss_sum, correct = eval_step(params, jnp.asarray(images), jnp.asarray(labels))
        total_loss += float(loss_sum)
        total_correct += int(correct)
        total += len(labels)
    return total_loss / total, total_correct / total


def get_preds(params, ds, batch_size=EVAL_BATCH_SIZE):
    """Return (y_true, y_pred, y_score = P(real)) on `ds`."""
    yt, yp, ys = [], [], []
    for images, labels in create_batches(ds, batch_size=batch_size):
        probs = jax.nn.softmax(
            model.apply({"params": params}, jnp.asarray(images), train=False), axis=-1)
        yt += labels.tolist()
        yp += np.asarray(jnp.argmax(probs, axis=-1)).tolist()
        ys += np.asarray(probs[:, 1]).tolist()
    return np.array(yt), np.array(yp), np.array(ys)


def run_epoch(epoch, params, opt_state):
    t0 = time.time()
    tot_loss = tot_correct = tot_n = 0.0
    for images, labels in create_batches(train_ds, batch_size=FT_BATCH_SIZE, shuffle=True):
        params, opt_state, loss, acc = train_step(
            params, opt_state, jnp.asarray(images), jnp.asarray(labels))
        n = len(labels)
        tot_loss += float(loss) * n
        tot_correct += float(acc) * n
        tot_n += n
    val_loss, val_acc = evaluate_model(params, val_ds)
    stats = dict(train_loss=tot_loss / tot_n, train_accuracy=tot_correct / tot_n,
                 val_loss=val_loss, val_accuracy=val_acc)
    print(f"Epoch {epoch}: train loss {stats['train_loss']:.4f} "
          f"acc {stats['train_accuracy']:.4f} | val loss {val_loss:.4f} "
          f"acc {val_acc:.4f} | {(time.time() - t0) / 60:.1f} min")
    return params, opt_state, stats


history = {"train_loss": [], "train_accuracy": [], "val_loss": [], "val_accuracy": []}
best_val_loss, best_epoch = float("inf"), 0
ft_params = None

if RUN_FINETUNE:
    have_ckpt = os.path.exists(BEST_CKPT)
    if have_ckpt and not FORCE_RETRAIN:
        # Reproduce the reported results from the saved epoch-1 checkpoint
        print("Loading saved checkpoint:", BEST_CKPT)
        with open(BEST_CKPT, "rb") as f:
            ft_params = serialization.from_bytes(variables["params"], f.read())
        ft_params = jax.tree_util.tree_map(jnp.asarray, ft_params)
        best_epoch = 1
    else:
        # Epoch 1, starting from the official pretrained weights
        ft_params = variables["params"]
        opt_state = optimizer.init(ft_params)
        print("Fine-tuning parameters:",
              sum(p.size for p in jax.tree_util.tree_leaves(ft_params)))
        ft_params, opt_state, stats = run_epoch(1, ft_params, opt_state)
        for k, v in stats.items():
            history[k].append(v)
        best_val_loss, best_epoch = stats["val_loss"], 1
        with open(BEST_CKPT, "wb") as f:                 # best (= epoch 1) checkpoint
            f.write(serialization.to_bytes(ft_params))
        with open(f"{CHECKPOINT_DIR}/vit_epoch1.msgpack", "wb") as f:
            f.write(serialization.to_bytes(ft_params))
        print("Best checkpoint saved:", BEST_CKPT)

    best_params = ft_params   # epoch-1 weights (selected by validation loss)

    # ---- held-out TEST evaluation of the selected model (run once) --------
    y_true, y_pred, y_scores = get_preds(best_params, test_ds)
    print("TEST RESULTS (selected model)")
    print("Accuracy :", accuracy_score(y_true, y_pred))
    print("Precision:", precision_score(y_true, y_pred), "(positive class = real)")
    print("Recall   :", recall_score(y_true, y_pred), "(positive class = real)")
    print("F1       :", f1_score(y_true, y_pred))
    print("ROC-AUC  :", roc_auc_score(y_true, y_scores))
    print("Errors   :", int((y_true != y_pred).sum()))
    print("Confusion matrix (rows = true fake/real):\n", confusion_matrix(y_true, y_pred))
    print(classification_report(y_true, y_pred, target_names=["Fake", "Real"]))

    np.savez(f"{RESULTS_DIR}/epoch1_predictions.npz",
             y_true=y_true, y_pred=y_pred, y_scores=y_scores)
    final_results = {
        "model": "ViT-B/16 Fine-Tuned",
        "dataset": "OpenDeepfake-Preview",
        "epochs": 1,
        "batch_size": FT_BATCH_SIZE,
        "learning_rate": LEARNING_RATE,
        "test_accuracy": float(accuracy_score(y_true, y_pred)),
        "test_precision": float(precision_score(y_true, y_pred)),
        "test_recall": float(recall_score(y_true, y_pred)),
        "test_f1": float(f1_score(y_true, y_pred)),
        "test_roc_auc": float(roc_auc_score(y_true, y_scores)),
        "confusion_matrix": confusion_matrix(y_true, y_pred).tolist(),
    }
    with open(f"{RESULTS_DIR}/fine_tuned_vit_results.json", "w") as f:
        json.dump(final_results, f, indent=4)


