# %% -------------------------------- 3. PREPROCESSING + BATCH GENERATOR
from PIL import Image

IMAGE_SIZE = 224


def preprocess_image(image):
    """RGB -> 224x224 (bicubic) -> scale to [-1, 1] (official Google ViT)."""
    image = image.convert("RGB").resize((IMAGE_SIZE, IMAGE_SIZE),
                                        Image.Resampling.BICUBIC)
    image = np.asarray(image, dtype=np.float32)
    return (image - 127.5) / 127.5


def create_batches(ds, batch_size=2, shuffle=False):
    indices = np.arange(len(ds))
    if shuffle:
        np.random.shuffle(indices)
    for start in range(0, len(indices), batch_size):
        batch_indices = indices[start:start + batch_size]
        images, labels = [], []
        for idx in batch_indices:
            sample = ds[int(idx)]
            images.append(preprocess_image(sample["image"]))
            labels.append(sample["label"])
        yield np.asarray(images, dtype=np.float32), np.asarray(labels, dtype=np.int32)


sample_image = preprocess_image(train_ds[0]["image"])
print("Processed shape:", sample_image.shape, "| range:",
