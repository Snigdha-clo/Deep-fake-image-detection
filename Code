# %% ------------------- 6. ABLATION: epochs 2-3 (analysis only, optional)
# Continues from the epoch-1 weights with a RE-INITIALISED AdamW state, exactly
# as in the reported ablation. The final model is still chosen by validation
# loss; test numbers for epochs 2-3 are for analysis, not selection.
if RUN_FINETUNE and RUN_ABLATION:
    # Recorded epoch-1 statistics (used when epoch 1 was loaded from a checkpoint)
    if not history["val_loss"]:
        history = {"train_loss": [0.2178], "train_accuracy": [0.9269],
                   "val_loss": [0.0555], "val_accuracy": [0.9800]}
    best_val_loss, best_epoch = history["val_loss"][0], 1
    best_params = ft_params
    epoch_params = {1: ft_params}

    opt_state = optimizer.init(ft_params)          # re-initialised optimiser state
    cur_params = ft_params
    np.random.seed(SEED)
    for epoch in (2, 3):
        cur_params, opt_state, stats = run_epoch(epoch, cur_params, opt_state)
        for k, v in stats.items():
            history[k].append(v)
        epoch_params[epoch] = cur_params
        with open(f"{CHECKPOINT_DIR}/vit_epoch{epoch}.msgpack", "wb") as f:
            f.write(serialization.to_bytes(cur_params))
        if stats["val_loss"] < best_val_loss:
            best_val_loss, best_params, best_epoch = stats["val_loss"], cur_params, epoch
    print("Best epoch by validation loss:", best_epoch)
    with open(f"{RESULTS_DIR}/training_history.json", "w") as f:
        json.dump(history, f, indent=2)

    ablation = {}
    for name, ep in [("epoch1", 1), ("epoch2", 2), ("epoch3", 3)]:
        yt, yp, ys = get_preds(epoch_params[ep], test_ds)
        ablation[name] = {"acc": float((yt == yp).mean()),
                          "auc": float(roc_auc_score(yt, ys)),
                          "errors": int((yt != yp).sum())}
        print(name, ablation[name])
    with open(f"{RESULTS_DIR}/ablation_epochs.json", "w") as f:
        json.dump(ablation, f, indent=2)

    # learning curves
    ep_axis = [1, 2, 3]
    fig, ax = plt.subplots(1, 2, figsize=(10, 4))
    for key, label in [("train_loss", "Train"), ("val_loss", "Validation")]:
        ax[0].plot(ep_axis, history[key], "o-", label=label)
    for key, label in [("train_accuracy", "Train"), ("val_accuracy", "Validation")]:
        ax[1].plot(ep_axis, history[key], "o-", label=label)
    for a, ylabel in zip(ax, ["Loss", "Accuracy"]):
        a.set_xlabel("Epoch"); a.set_ylabel(ylabel); a.set_xticks(ep_axis)
        a.legend(); a.grid(alpha=.3)
    plt.tight_layout()
    plt.savefig(f"{RESULTS_DIR}/vit_learning_curves.png", dpi=300)
    plt.show()


# %% --------------- 7. DUPLICATE AUDIT on the EVALUATED train/val/test split
# Exact-duplicate check by hashing decoded pixels (size + RGB bytes).
# Uses its own variable names, so it never overwrites train_ds / test_ds.
if RUN_DUPLICATE_AUDIT:
    import hashlib
    from collections import defaultdict

    def image_hash(image):
        image = image.convert("RGB")
        return hashlib.sha256(str(image.size).encode() + image.tobytes()).hexdigest()

    where = defaultdict(list)                       # hash -> [(split, index, label)]
    for split_name, ds in [("train", train_ds), ("validation", val_ds), ("test", test_ds)]:
        print("Hashing:", split_name)
        for idx, sample in enumerate(ds):
            where[image_hash(sample["image"])].append((split_name, idx, sample["label"]))

    total = sum(len(v) for v in where.values())
    cross = {h: loc for h, loc in where.items() if len({s for s, _, _ in loc}) > 1}
    conflicting = [h for h, loc in where.items() if len({l for _, _, l in loc}) > 1]
    test_in_train = {h for h, loc in cross.items()
                     if any(s == "test" for s, _, _ in loc)
                     and any(s == "train" for s, _, _ in loc)}
    test_leaked_idx = sorted({i for h in test_in_train
                              for s, i, _ in where[h] if s == "test"})

    print("\nDUPLICATE AUDIT (evaluated split)")
    print("Total images             :", total)
    print("Unique pixel hashes      :", len(where))
    print("Redundant exact copies   :", total - len(where))
    print("Cross-split groups       :", len(cross))
    print("Groups with label conflict:", len(conflicting))
    print("Test images also in train:", len(test_leaked_idx))

    # Accuracy with train-duplicated test images removed (if predictions exist)
    if RUN_FINETUNE:
        keep = np.ones(len(y_true), dtype=bool)
        keep[test_leaked_idx] = False
        print(f"Test accuracy, full test set      : {(y_true == y_pred).mean():.4f}  (n={len(y_true)})")
        print(f"Test accuracy, leakage-free subset: "
              f"{(y_true[keep] == y_pred[keep]).mean():.4f}  (n={int(keep.sum())})")
        print(f"Test ROC-AUC, leakage-free subset : "
              f"{roc_auc_score(y_true[keep], y_scores[keep]):.4f}")

print("\nDone. Results are in:", RESULTS_DIR)
